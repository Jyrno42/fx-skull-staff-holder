// Super needs the full stage set or the model renders black. Diffuse comes from the face
// texture on the p3d, not Stage7.
// 30% down on the vanilla castle stone _co. These multiply the texture, ambient in shade and
// diffuse in sun, so they move together.
ambient[]={0.49,0.49,0.49,1};
diffuse[]={0.49,0.49,0.49,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={0,0,0,1};
// Stone is near matte.
specular[]={0.08,0.08,0.08,1};
specularPower=12;
PixelShaderID="Super";
VertexShaderID="Super";
class Stage1
{
	texture="dz\structures\data\bricks\bricks_rocks_castle_01_nohq.paa";
	uvSource="tex";
	class uvTransform
	{
		aside[]={1,0,0};
		up[]={0,1,0};
		dir[]={0,0,0};
		pos[]={0,0,0};
	};
};
